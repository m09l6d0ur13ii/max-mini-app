# ==========================================
# Telegram Bot Configuration
# ==========================================
# Токен Telegram-бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID группы/супергруппы Telegram, куда пересылать сообщения и откуда читать (например: -1001234567890)
TELEGRAM_CHAT_ID=-1001234567890

# ==========================================
# MAX Messenger Bot Configuration
# ==========================================
# Токен бота MAX, полученный в платформе MAX (https://dev.max.ru)
MAX_BOT_TOKEN=your_max_bot_token_here

# ID группового чата в MAX, куда пересылать сообщения и откуда читать
MAX_CHAT_ID=12345678

# ==========================================
# WebApp / Mini App & Server Configuration
# ==========================================
# Порт локального веб-сервера для Mini-App и Webhook (по умолчанию 3000)
PORT=3000

# Публичный URL Mini-App (если размещён на домене или ngrok/localtunnel)
# Используется для открытия веб-приложения внутри MAX через https://dev.max.ru/docs/webapps/bridge
WEBAPP_URL=http://localhost:3000

# Включить синхронизацию реакций (true / false)
SYNC_REACTIONS=true

# Режим отладки (true / false)
DEBUG=false
